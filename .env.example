# REQUIRED. The canonical public origin, no trailing slash.
#
# This is the single source of truth for every absolute URL the site emits:
# canonical, og:url, og:image, twitter:image, robots.txt Host and Sitemap, the
# sitemap <loc> entries, the JSON-LD @id/url/image/logo, and the www -> apex
# redirect. Changing domains is this one edit plus a redeploy — nothing else.
#
# Never hardcode the domain anywhere in the codebase. A prototype domain left in
# the code once pointed Google's canonical at a host that 404s, which kept the
# site out of the index entirely.
#
# Unset, the build falls back to the domain Railway reports and prints a loud
# warning naming the value it adopted. That fallback is a safety net, not a
# configuration: Railway reports whichever domain is attached to the service,
# which may be a staging or legacy one.
NEXT_PUBLIC_SITE_URL=https://perezroughframing.com

# Leadprime lead intake. REQUIRED for the estimate form to deliver.
# Set either the full URL or just the key. Server-side only — never expose the
# webhook as a NEXT_PUBLIC_* variable and never commit it: this repository is
# public and the endpoint is unauthenticated.
LEADPRIME_WEBHOOK_URL=
LEADPRIME_WEBHOOK_KEY=

# Optional. Only exists after rotating the webhook key in Leadprime. When set,
# requests are signed with X-LeadPrime-Signature (HMAC-SHA256).
LEADPRIME_WEBHOOK_SECRET=

# Optional. Defaults to the account's published Embed Kit token.
NEXT_PUBLIC_LEADPRIME_WIDGET_TOKEN=

# Optional. Defaults to https://leadprime.chyrris.com for both the webhook and
# the widget. Override only to point at a different Leadprime deployment.
LEADPRIME_API_BASE=
NEXT_PUBLIC_LEADPRIME_API_BASE=
